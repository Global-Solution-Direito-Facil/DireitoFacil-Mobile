# Copie para .env e ajuste. Nunca coloque senhas ou chaves aqui.

# mock = dados falsos no aparelho (para desenvolver sem backend)
# api  = chama as APIs reais (Java e .NET)
EXPO_PUBLIC_DATA_SOURCE=mock

# API Java (Spring Boot): login, pessoas, laudos, direitos e casos
EXPO_PUBLIC_JAVA_API_URL=http://10.0.2.2:8080

# API .NET (Minimal API no Azure): documentos e envios
EXPO_PUBLIC_DOTNET_API_URL=http://10.0.2.2:5000

# Hash do commit exibido na tela "Sobre o App" (preenchido no build)
EXPO_PUBLIC_COMMIT_HASH=dev
