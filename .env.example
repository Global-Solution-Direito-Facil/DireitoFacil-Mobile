# Copie para .env e ajuste. Nunca coloque senhas ou chaves aqui.

# mock = dados falsos no aparelho (para desenvolver sem backend)
# api  = chama as APIs reais (Java e .NET)
EXPO_PUBLIC_DATA_SOURCE=mock

# API Java (Spring Boot): login, pessoas, laudos, direitos, casos e receitas.
# So o endereco do servidor, sem o /api/v1 no fim: o app coloca.
# Local (emulador Android):
EXPO_PUBLIC_JAVA_API_URL=http://10.0.2.2:8080
# Publicada no Render (a primeira chamada depois de parada leva ate 1 minuto):
# EXPO_PUBLIC_JAVA_API_URL=https://direitofacil-java.onrender.com

# API .NET (ASP.NET Core Web API): documentos e envios. So o endereco: o app
# coloca o prefixo. Rodando local, a .NET usa a porta 5264.
EXPO_PUBLIC_DOTNET_API_URL=http://10.0.2.2:5264
# Publicada no Azure App Service:
# EXPO_PUBLIC_DOTNET_API_URL=https://direitofacil-rm561378.azurewebsites.net

# Prefixo das rotas da .NET (opcional). Padrao /api, o que esta publicado.
# EXPO_PUBLIC_DOTNET_API_PREFIX=/api

# O hash do commit da tela "Sobre o app" NAO vai aqui: o app.config.js le
# do git na hora do build.
